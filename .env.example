# Copy this file to .env for local development and fill in the values.
# On Vercel, add the same names under Project Settings > Environment Variables.
# Never commit the real .env file.

# MongoDB Atlas connection string (with the NEW password after rotating it).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/

# Random secret for login tokens, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Comma-separated emails that get admin access after signing up and verifying.
ADMIN_EMAILS=

# Gmail account that sends OTP emails, and its 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# UploadThing secret key (sk_live_...). Create a NEW key; the old one is public.
UPLOADTHING_SECRET=

# WhatsApp number that receives orders, with country code, digits only.
WHATSAPP_NUMBER=919213517228

# Set to true only after the mobile app is updated to log in.
# While false, the existing app endpoints stay open as they are today.
ADMIN_AUTH_ENFORCED=false
